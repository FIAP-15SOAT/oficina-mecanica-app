@startuml c4-system-context
!include lib/C4-PlantUML/C4_Context.puml

!$LEGEND_TITLE_TEXT = "Legenda"
UpdateElementStyle("person", $legendText="Pessoa")
UpdateElementStyle("external_person", $legendText="Pessoa Externa")
UpdateElementStyle("system", $legendText="Sistema de Software")
UpdateElementStyle("external_system", $legendText="Sistema Externo")

SHOW_ELEMENT_TYPE($hidePersonType="false")
SHOW_PERSON_OUTLINE()

title Diagrama de Contexto do Sistema - Sistema da Oficina Mecânica

Person(admin, "Administrador", "Funcionário da oficina responsável pela configuração geral do sistema e por tarefas administrativas")
Person(mecanico, "Mecânico", "Profissional da oficina responsável por executar os serviços nos veículos")
Person(atendente, "Atendente", "Funcionário da oficina responsável pelo atendimento e relacionamento com os clientes")

System(oficina, "Sistema da Oficina Mecânica", "Permite à oficina gerenciar clientes, veículos, ordens de serviço, peças, orçamentos e estoque")

Person_Ext(cliente, "Cliente da Oficina", "Dono do veículo levado para manutenção na oficina")

System_Ext(smtp, "Servidor SMTP", "Servidor de e-mail responsável por notificar os clientes sobre orçamentos")

Rel(admin, oficina, "Gerencia usuários, serviços, peças, clientes, veículos, ordens de serviço, orçamentos e estoque")
Rel(mecanico, oficina, "Executa e atualiza as ordens de serviço sob sua responsabilidade")
Rel(atendente, oficina, "Cadastra clientes e veículos, e cria e gerencia ordens de serviço e orçamentos")

Rel_R(oficina, smtp, "Envia e-mail com o orçamento para aprovação")
Rel_U(smtp, cliente, "Entrega o e-mail com o orçamento")
Rel_U(cliente, oficina, "Aprova ou rejeita o orçamento recebido")

SHOW_LEGEND()
@enduml
