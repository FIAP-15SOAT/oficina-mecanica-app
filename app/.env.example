PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techchallenge?schema=public"

JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_REFRESH_EXPIRATION=7d
CUSTOMER_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"
CUSTOMER_JWT_ISSUER=oficina-customer-auth
CUSTOMER_JWT_AUDIENCE=oficina-api
QUOTE_DECISION_TOKEN_SECRET=your-quote-decision-secret-key-here

BCRYPT_SALT_ROUNDS=12

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM="Oficina Mecânica <noreply@oficina.local>"

ALLOWED_ORIGINS=http://localhost:3000

# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent (padrão: info)
LOG_LEVEL=info
OTEL_SERVICE_NAME=oficina-mecanica-api
OTEL_SERVICE_NAMESPACE=oficina-mecanica
# TRUSTED_PROXY_CIDRS: lista separada por vírgula (ex.: 10.0.0.0/8,loopback).
# Ausente ou inválida = nenhum proxy confiável e cabeçalhos encaminhados são ignorados.
# TRUSTED_PROXY_CIDRS=
